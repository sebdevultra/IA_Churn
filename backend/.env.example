# Environment Variables Configuration
ENVIRONMENT=development
PROJECT_NAME="Customer Sentiment & Churn Risk Monitor"
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_123456789

# Database Configuration
# For local run: uses SQLite by default (zero setup required)
# For PostgreSQL/Docker: postgresql://churn_user:churn_password@localhost:5432/churn_monitor_db
DATABASE_URL=sqlite:///./churn_monitor.db

# Artificial Intelligence (LLM) Configuration
# Providers supported: deterministic_rule, openai, gemini
AI_PROVIDER=deterministic_rule
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ingestion & Automation Worker (APScheduler)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
DATA_WATCH_DIR=./data
AUTO_INGEST_SAMPLE_DATA=true

# Risk Engine Thresholds
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

# Logging & Monitoring
LOG_LEVEL=INFO
